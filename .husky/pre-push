#!/usr/bin/env sh
set -e

ZERO="0000000000000000000000000000000000000000"
BACKEND_CHANGED=0
FRONTEND_CHANGED=0

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_sha" != "$ZERO" ]; then
    if git diff --name-only "$remote_sha..$local_sha" | grep -q '^backend/'; then
      BACKEND_CHANGED=1
    fi
    if git diff --name-only "$remote_sha..$local_sha" | grep -q '^frontend/'; then
      FRONTEND_CHANGED=1
    fi
  else
    BACKEND_CHANGED=1
    FRONTEND_CHANGED=1
  fi
done

if [ "$BACKEND_CHANGED" = "1" ]; then
  bash .husky/scripts/backend-prepush.sh
fi

if [ "$FRONTEND_CHANGED" = "1" ]; then
  echo "Frontend pre-push: type-check & build"
  (cd frontend && npm run build)
fi

exit 0
